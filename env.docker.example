# Copy to .env for `docker compose up`. Secrets stay in the environment, never in chains.toml.
#
# These are the well-known anvil/hardhat development mnemonics. They are PUBLIC:
# never send real funds to addresses derived from them.
MNEMONIC="test test test test test test test test test test test junk"
FAUCET_MNEMONIC="test test test test test test test test test test test junk"

# Bearer token for POST /admin/* and for outgoing webhooks (placeholder).
WEBHOOK_JWT_TOKEN=dev-admin-token

# Network the default /evm/block_number routes act on. Unset: the first [[chains]] entry.
# DEFAULT_CHAIN=polygon

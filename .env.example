# Copy to .env for `cargo run`. See env.docker.example for the docker compose variant.
# Public anvil/hardhat development mnemonics: never fund them.
MNEMONIC="test test test test test test test test test test test junk"
FAUCET_MNEMONIC="test test test test test test test test test test test junk"
CHAINS_CONFIG=chains.toml
# SQLite file for a quick local run, or a postgres:// URL (then DB_TLS_MODE=disable for a local server).
DATABASE_URL=sqlite:wallet.db
PORT=3000
WEBHOOK_JWT_TOKEN=dev-admin-token

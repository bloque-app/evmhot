# ==============================================
# EVM Hot Wallet - Docker Production Configuration
# ==============================================
# Copy this file to .env and configure with your values
# WARNING: Never commit .env file with real secrets!

# Database (using Docker volume path)
DATABASE_URL=/app/data/wallet.db

# Hot Wallet Mnemonic (derives deposit addresses — same on all EVM chains)
MNEMONIC=your twelve word mnemonic phrase goes here for hot wallet

# Faucet Mnemonic (lazy-funds addresses for gas at sweep time)
FAUCET_MNEMONIC=another twelve word mnemonic phrase for faucet wallet funding

# Path to per-chain configuration (mount chains.toml into the container)
CHAINS_CONFIG=/app/chains.toml

# Optional: chain name used when migrating legacy single-chain DB data
# LEGACY_CHAIN=polygon

# API Server
PORT=3000

# Optional: JWT sent as Authorization: Bearer on webhooks
# WEBHOOK_JWT_TOKEN=your-secret-token
